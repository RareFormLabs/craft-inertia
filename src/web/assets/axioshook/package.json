{
  "name": "axioshook",
  "version": "0.0.0",
  "devDependencies": {
    "npm-run-all2": "^8.0.4",
    "sane": "^5.0.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.11"
  },
  "private": true,
  "scripts": {
    "dev": "sane 'npm run build' src",
    "build": "run-s build:dev build:min --print-label",
    "build:dev": "vite build --config vite.config.dev.ts",
    "build:min": "vite build --config vite.config.min.ts"
  },
  "type": "module"
}
